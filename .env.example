# copy to .env and fill in; never commit .env
JOURNEY_SOURCE=bahn

# AI report (optional; without a key the template text is used)
OPENROUTER_API_KEY=<your-key>
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# only for HTTPS on a server (docker compose --profile https up); leave empty locally
DOMAIN=

# optional: delay-station file, if it is not under data/processed/
# STATIONS_PARQUET=data/processed/dim_stations.parquet

# optional: time of the daily update, Berlin time (default 04:30)
# UPDATE_HOUR=4
# UPDATE_MINUTE=30